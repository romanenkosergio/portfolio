{
  "name": "next-tailwind",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p 6060",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "prepare": "husky",
    "format": "prettier --write . --cache --log-level=warn",
    "format:check": "prettier --check . --cache --log-level=warn",
    "typecheck": "next typegen >/dev/null && tsc --noEmit",
    "fsd": "steiger ./src",
    "shadcn:add": "node scripts/shadcn-add.mjs",
    "gate": "yarn format:check && yarn lint && yarn typecheck && yarn fsd && yarn egress && yarn snippets && yarn dup && yarn test:coverage",
    "egress": "node scripts/egress-check.mjs",
    "snippets": "node scripts/snippets-check.mjs",
    "dup": "jscpd",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "postbuild": "node scripts/csp-first.mjs",
    "size": "node scripts/size.mjs",
    "gate:push": "yarn gate && yarn build && yarn size"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@svgr/webpack": "^8.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^0.577.0",
    "next": "^16.3.6",
    "next-intl": "^4.14.9",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@feature-sliced/steiger-plugin": "^0.8.0",
    "@shadcn/lint": "^0.2.1",
    "@size-limit/file": "^14.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest": "^30",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^24",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.70.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jest": "^30",
    "jest-axe": "^11.0.0",
    "jest-environment-jsdom": "^30",
    "jscpd": "^5.4.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^3.8.5",
    "size-limit": "^14.2.0",
    "steiger": "^0.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "engines": {
    "node": ">=24"
  },
  "resolutions": {
    "@types/react": "19.3.0",
    "**/@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": ">=8.5.10"
  }
}
