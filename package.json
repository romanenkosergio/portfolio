{
  "name": "next-tailwind",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npx steiger ./src --watch\" \"next dev\"",
    "build": "next build",
    "start": "next start -p 6060",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "format": "prettier --write . --cache --log-level=warn",
    "format:check": "prettier --check . --cache --log-level=warn",
    "typecheck": "tsc --noEmit",
    "fsd": "steiger ./src",
    "gate": "yarn format:check && yarn lint && yarn typecheck && yarn fsd",
    "gate:push": "yarn gate && yarn build"
  },
  "dependencies": {
    "@svgr/webpack": "^8.1.0",
    "next": "^16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.4",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.17.0",
    "@feature-sliced/eslint-config": "^0.1.1",
    "@feature-sliced/steiger-plugin": "^0.5.4",
    "@next/eslint-plugin-next": "^16.4.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.18.1",
    "concurrently": "^9.1.2",
    "eslint": "^9",
    "eslint-config-next": "^16.3.6",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-boundaries": "^5.0.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-local-rules": "^3.0.2",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^15.13.0",
    "husky": "^9.1.7",
    "postcss": "^8.5.28",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "steiger": "^0.5.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.18.1"
  },
  "engines": {
    "node": ">=24"
  },
  "resolutions": {
    "@types/react": "19.3.0",
    "**/@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": ">=8.5.10"
  }
}
